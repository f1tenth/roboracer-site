# Large media (the hero clip cycle) is served from Cloudflare R2, not from the
# site: the files are far over the repo's 1.5 MB rule. src/lib/media.ts turns
# "/media/hero/x.mp4" into "$VITE_MEDIA_BASE/media/hero/x.mp4"; with the
# variable unset the local copy under public/ is used, which is how the clips
# play on localhost.
VITE_MEDIA_BASE=https://pub-1174c726236842f08529a0a5cc0c68fb.r2.dev
