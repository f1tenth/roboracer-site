 "intro": {
  "title": "Learn autonomous racing",
  "overview": "RoboRacer is a hands-on course in the foundations of autonomy: perception, planning and control, practiced on a 1/10-scale race car. Start in the simulator with ROS 2, build up through mapping, optimal control and reinforcement learning, then race what you wrote. Built for graduate and senior undergraduate students.",
  "video_id": "hXmGTKom4O8",
  "video_title": "RoboRacer course introduction",
  "slides_embed": "https://docs.google.com/presentation/d/e/2PACX-1vTCwyQ5XAae2FpuUS64vCq4f_TZHtzXg_7G4aSgioYSi_54t1pvIAjT0sPt2nqFFA/embed?start=false&loop=false&delayms=3000&slide=id.p1",
  "slides_title": "RoboRacer course overview slides",
  "teaches": [
   "Perception",
   "Planning",
   "Control",
   "Analytic skills to recognize and reason about situations with moral content in the design of autonomous systems"
  ],
  "not": [
   "Mechatronics",
   "A deep learning course",
   "A replacement for the semester-long graduate courses in the topics we cover",
   "Easy"
  ],
  "prerequisites": [
   "Basic knowledge of Linux",
   "Optimization theory",
   "Programming skills (preferably C++ or Python)"
  ],
  "note": "This course integrates the concepts above and is not a beginner course in any of them. The material is best suited to graduate level, or at the very least a senior undergraduate course.",
  "community": "Join the discussion on Slack. The workspace is for educators, collaborators and organizers."
 },
 "syllabus": {
  "lead": "A semester-long course. Run it as it stands, or pick and choose lectures to fit a quarter or shorter.",
  "components": [
   {
    "title": "Lectures",
    "body": "Taught clab-style (classroom plus lab): each session pairs a lecture with tutorial or lab time."
   },
   {
    "title": "Labs",
    "body": "Done outside class time. This is where students apply what the lectures teach."
   },
   {
    "title": "Races",
    "body": "Three races, each testing a different part of the class: Race 1 on basic methods, Race 2 on advanced control, and the final race."
   },
   {
    "title": "Final project",
    "body": "Students propose a problem and solve it on the RoboRacer vehicle system, in teams of 3 to 4 with different skills."
   }
  ],
  "outline_title": "Fall 2026 outline"
 },
