{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx vite *)",
      "Bash(npx playwright *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(scripts/rr.sh *)",
      "Bash(./scripts/rr.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(gh pr *)",
      "Bash(gh repo list *)",
      "Bash(gh repo clone *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(cwebp *)",
      "Bash(magick *)",
      "Bash(ls *)",
      "Bash(du *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(curl *)",
      "WebFetch(domain:neobotics.org)",
      "WebFetch(domain:roboracer.ai)",
      "WebFetch(domain:iros2026-race.roboracer.ai)",
      "WebFetch(domain:cedrichollande.com)",
      "WebFetch(domain:web.archive.org)",
      "WebFetch(domain:gsap.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:api.openalex.org)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:export.arxiv.org)",
      "WebFetch(domain:arxiv.org)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(npm run deploy*)",
      "Bash(npx gh-pages*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh"
          }
        ]
      }
    ]
  }
}
